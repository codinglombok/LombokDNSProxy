{
  "name": "lombok-dns-proxy-extension",
  "version": "1.0.0",
  "description": "LombokDNSProxy browser extension — privacy-first DNS proxy + ad blocker",
  "license": "Apache-2.0",
  "author": "@codinglombok",
  "repository": {
    "type": "git",
    "url": "https://github.com/codinglombok/lombok-dns-proxy",
    "directory": "src/browser-ext"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc --noEmit && vite build --mode production",
    "build:firefox": "cross-env BROWSER=firefox vite build --mode production",
    "build:all": "npm run build && npm run build:firefox",
    "lint": "eslint . --ext .ts",
    "type-check": "tsc --noEmit",
    "fuzz": "jest"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/jest": "^29.5.12",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "lombokfuzzer": "^0.1.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.0",
    "vite": "^8.3.5",
    "vite-plugin-web-extension": "^4.0.0"
  }
}
